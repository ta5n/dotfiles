# ~/.bashrc - Cross-platform Bash Configuration
# Compatible with: Linux, WSL, Git Bash for Windows

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Platform detection
case "$(uname -s)" in
  Linux*)     PLATFORM=Linux;;
  Darwin*)    PLATFORM=Mac;;
  CYGWIN*)    PLATFORM=Cygwin;;
  MINGW*)     PLATFORM=MinGw;;
  MSYS*)      PLATFORM=Msys;;
  *)          PLATFORM="UNKNOWN:$(uname -s)"
esac

# Check if running in WSL
if grep -qEi "(Microsoft|WSL)" /proc/version &> /dev/null 2>&1; then
  IS_WSL=true
else
  IS_WSL=false
fi

# History configuration
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
shopt -s cmdhist

# Shell options
shopt -s checkwinsize
shopt -s expand_aliases
shopt -s globstar 2>/dev/null
shopt -s nocaseglob
shopt -s cdspell
shopt -s dirspell

# Colors
if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
fi

# Custom PATH additions
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/bin:$PATH"

# Editor configuration
if command -v nvim &> /dev/null; then
  export EDITOR='nvim'
  export VISUAL='nvim'
elif command -v vim &> /dev/null; then
  export EDITOR='vim'
  export VISUAL='vim'
else
  export EDITOR='vi'
  export VISUAL='vi'
fi

# Language environment
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Go configuration
if command -v go &> /dev/null; then
  export GOPATH="$HOME/go"
  export PATH="$GOPATH/bin:$PATH"
fi

# Rust configuration
if [ -f "$HOME/.cargo/env" ]; then
  source "$HOME/.cargo/env"
fi

# Node.js configuration (nvm)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Prompt configuration
parse_git_branch() {
  git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

# Color definitions
RED='\[\033[01;31m\]'
GREEN='\[\033[01;32m\]'
YELLOW='\[\033[01;33m\]'
BLUE='\[\033[01;34m\]'
PURPLE='\[\033[01;35m\]'
CYAN='\[\033[01;36m\]'
WHITE='\[\033[01;37m\]'
RESET='\[\033[00m\]'

# Set colorful PS1
if [ "$EUID" -eq 0 ]; then
  PS1="${RED}\u${RESET}@${GREEN}\h${RESET}:${BLUE}\w${RESET} ${YELLOW}\$(parse_git_branch)${RESET}\n# "
else
  PS1="${GREEN}\u${RESET}@${CYAN}\h${RESET}:${BLUE}\w${RESET} ${YELLOW}\$(parse_git_branch)${RESET}\n$ "
fi

# GRC (Generic Colouriser) - colorize output of various commands
if command -v grc &> /dev/null; then
  # Source grc bash configuration if available
  [[ -s "/etc/grc.bashrc" ]] && source /etc/grc.bashrc
  [[ -s "/usr/local/etc/grc.bashrc" ]] && source /usr/local/etc/grc.bashrc
  [[ -s "$HOME/.grc/grc.bashrc" ]] && source $HOME/.grc/grc.bashrc

  # Manual aliases if grc.bashrc not found
  if ! type -t grc &> /dev/null; then
    alias colourify='grc -es --colour=auto'
    alias configure='colourify ./configure'
    alias diff='colourify diff'
    alias make='colourify make'
    alias gcc='colourify gcc'
    alias g++='colourify g++'
    alias as='colourify as'
    alias gas='colourify gas'
    alias ld='colourify ld'
    alias netstat='colourify netstat'
    alias ping='colourify ping'
    alias traceroute='colourify traceroute'
    alias head='colourify head'
    alias tail='colourify tail'
    alias dig='colourify dig'
    alias mount='colourify mount'
    alias ps='colourify ps'
    alias mtr='colourify mtr'
    alias df='colourify df'
  fi
fi

# Aliases
# lsd (LSDeluxe) aliases - modern ls replacement
if command -v lsd &> /dev/null; then
  alias ls='lsd'
  alias l='lsd -l'
  alias ll='lsd -lA'
  alias la='lsd -A'
  alias lla='lsd -lA'
  alias lt='lsd --tree'
  alias lta='lsd --tree -A'
  alias ltd='lsd --tree --depth'
else
  # Fallback to standard ls
  alias ls='ls --color=auto'
  alias ll='ls -lah'
  alias la='ls -A'
  alias l='ls -CF'
fi

# Grep aliases
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Git aliases
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias glog='git log --oneline --decorate --graph'

# Editor aliases
if command -v nvim &> /dev/null; then
  alias vim='nvim'
  alias vi='nvim'
fi

# Navigation aliases
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# Docker aliases
alias dc='docker-compose'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias di='docker images'

# Kubectl aliases
alias k='kubectl'
alias kgp='kubectl get pods'
alias kgs='kubectl get services'
alias kgd='kubectl get deployments'

# Safety aliases
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Update aliases
alias update-dotfiles='chezmoi update'

# Platform-specific aliases
{{- if eq .chezmoi.os "darwin" }}
# macOS specific
alias update='brew update && brew upgrade'
{{- else if eq .chezmoi.os "linux" }}
# Linux specific
{{- if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
# WSL specific
alias winpath='cd /mnt/c/Users/$USER'
export DISPLAY=:0
{{- else }}
# Native Linux
alias update='sudo apt update && sudo apt upgrade -y'
{{- end }}
{{- end }}

# Functions
# Create directory and cd into it
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Extract archives
extract() {
  if [ -f "$1" ]; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"    ;;
      *.tar.gz)    tar xzf "$1"    ;;
      *.bz2)       bunzip2 "$1"    ;;
      *.rar)       unrar x "$1"    ;;
      *.gz)        gunzip "$1"     ;;
      *.tar)       tar xf "$1"     ;;
      *.tbz2)      tar xjf "$1"    ;;
      *.tgz)       tar xzf "$1"    ;;
      *.zip)       unzip "$1"      ;;
      *.Z)         uncompress "$1" ;;
      *.7z)        7z x "$1"       ;;
      *)           echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# Find file
ff() {
  find . -type f -iname "*$1*"
}

# Find directory
fd() {
  find . -type d -iname "*$1*"
}

# Load bash completion
if [ -f /etc/bash_completion ]; then
  . /etc/bash_completion
fi

# Git Bash for Windows specific
if [ "$PLATFORM" = "MinGw" ] || [ "$PLATFORM" = "Msys" ]; then
  # Windows-specific configurations
  export TERM=xterm-256color
fi

# Load local configuration if exists
[[ -f ~/.bashrc.local ]] && source ~/.bashrc.local

# If zsh is available and installed, suggest switching
if command -v zsh &> /dev/null && [ -d "$HOME/.oh-my-zsh" ]; then
  echo "ZSH is installed. Run 'exec zsh' to switch to ZSH shell."
fi
