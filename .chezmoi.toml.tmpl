# Chezmoi configuration file
# This file contains configuration for chezmoi itself

[data]
    # User information (used in templates)
    name = "{{ .name | default "Your Name" }}"
    email = "{{ .email | default "your.email@example.com" }}"

[diff]
    # Use a pager for diffs
    pager = "less -FRX"

[merge]
    # Use vimdiff for merge conflicts
    command = "vimdiff"

[edit]
    # Use preferred editor
    command = "{{ if lookPath "nvim" }}nvim{{ else if lookPath "vim" }}vim{{ else }}vi{{ end }}"

[status]
    # Exclude specific files from status
    exclude = ["scripts"]
